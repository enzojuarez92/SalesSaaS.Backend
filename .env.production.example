# Dominio público, sin https://
APP_DOMAIN=app.tudominio.com
LETSENCRYPT_EMAIL=admin@tudominio.com

# SQL Server Express es apto para producción pequeña (límite de 10 GB por base).
MSSQL_SA_PASSWORD=REEMPLAZAR_POR_UN_SECRETO_DE_64_CARACTERES
DATABASE_MIGRATE_ON_STARTUP=false

# Seguridad de la API
Jwt__Key=REEMPLAZAR_POR_UN_SECRETO_DE_64_CARACTERES
Jwt__Issuer=KloverCloud
Jwt__Audience=KloverCloud.Client
CORS_ALLOWED_ORIGINS=https://app.tudominio.com

# Mercado Pago Producción
MERCADOPAGO_ACCESS_TOKEN=APP_USR_TOKEN_DE_PRODUCCION
MERCADOPAGO_USE_SANDBOX=false
MERCADOPAGO_ENABLE_MOCK_CHECKOUT=false
MERCADOPAGO_SUCCESS_URL=https://app.tudominio.com/suscripcion?payment=success
MERCADOPAGO_FAILURE_URL=https://app.tudominio.com/suscripcion?payment=failure
MERCADOPAGO_NOTIFICATION_URL=https://app.tudominio.com/api/subscription/mp-webhook
MERCADOPAGO_WEBHOOK_SECRET=SECRETO_WEBHOOK_MERCADO_PAGO

# Correo transaccional: completar antes de habilitar correos reales
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_USE_SSL=true
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_SENDER_EMAIL=
