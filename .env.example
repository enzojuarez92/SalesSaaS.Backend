# Contraseña para el contenedor Docker de SQL Server
MSSQL_SA_PASSWORD=TuPasswordSegura123!

# Connection String
# JWT
Jwt__Key="TuClaveSecretaSuperLargaYSeguraDe32CaracteresMinimo"
Jwt__Issuer="SalesSaaS"
Jwt__Audience="SalesSaaS.Client"

# Mercado Pago. Para probar el checkout real en sandbox usá un token APP_USR de
# prueba y configurá MERCADOPAGO_USE_SANDBOX=true. El modo simulado es opt-in.
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_NOTIFICATION_URL=
MERCADOPAGO_SUCCESS_URL=https://app.klovercloud.com/suscripcion?payment=success
MERCADOPAGO_FAILURE_URL=https://app.klovercloud.com/suscripcion?payment=failure
MERCADOPAGO_WEBHOOK_SECRET=
MERCADOPAGO_USE_SANDBOX=false
MERCADOPAGO_ENABLE_MOCK_CHECKOUT=false

# Puerto público de Nginx: usá 80 en producción si está disponible.
FRONTEND_PORT=8080
SQLSERVER_PORT=1433
